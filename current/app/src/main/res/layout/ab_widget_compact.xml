<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ab_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:minHeight="64dp" android:clipChildren="true" android:clipToPadding="true">
    <ImageView android:id="@+id/ab_widget_background" android:src="@drawable/ab_widget_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">
        <ImageView android:id="@+id/ab_widget_cover" android:src="@drawable/ab_widget_book_placeholder" android:layout_width="30dp" android:layout_height="40dp" android:layout_marginStart="10dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:layout_marginEnd="8dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/ab_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#F5FAFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Ваша аудиокнига" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/ab_widget_chapter" android:text="Глава 1 из 12" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#F5FAFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
                <ImageButton android:id="@+id/ab_widget_configure" android:src="@drawable/ab_widget_preview_configure_icon" android:layout_width="26dp" android:layout_height="26dp" android:background="@android:color/transparent" android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="@string/ab_widget_configure" />
            </LinearLayout>
        </LinearLayout>
        <ImageButton android:id="@+id/ab_widget_previous" android:src="@drawable/ab_widget_preview_previous_icon" android:layout_width="38dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="@string/ab_widget_previous" />
        <ImageButton android:id="@+id/ab_widget_toggle" android:src="@drawable/ab_widget_preview_toggle_icon" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="@string/ab_widget_toggle" />
        <ImageButton android:id="@+id/ab_widget_next" android:src="@drawable/ab_widget_preview_next_icon" android:layout_width="38dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="@string/ab_widget_next" />
    </LinearLayout>
</FrameLayout>