+            (h==='yastatic.net'&&/^\/(?:safeframe-bundles|partner-code-bundles)\//.test(p));
+    }catch(e){return false;}}
+    function collect(doc,external){var all=doc.scripts||[],rows=[],bytes=0;
+        for(var i=0;i<all.length&&i<4000;i++){
